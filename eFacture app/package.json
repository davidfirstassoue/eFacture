{
  "name": "efacture-hopital",
  "version": "1.0.0",
  "description": "Système de Gestion des Bons de Commande Internes - CHU Owendo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.chu.bci.hopital",
    "productName": "BCI Hopital",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "public/logo.png"
    },
    "asarUnpack": [
      "**/better-sqlite3/**"
    ]
  },
  "keywords": [],
  "author": "David",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
